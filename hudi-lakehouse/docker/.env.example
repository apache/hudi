# Copy to .env; it is gitignored. Shell environment overrides .env values.
# Use published image references here when a release registry is available.
SPARK_CONNECT_IMAGE=hudi-lakehouse-spark-connect:4.1.3-hudi1.2.0
GATEWAY_IMAGE=hudi-lakehouse-agent-gateway:0.1.0

# Host Ollama (default); pull qwen3:8b on the host before starting chat.
GATEWAY_LLM_PROVIDER=ollama
GATEWAY_LLM_MODEL=qwen3:8b
GATEWAY_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Alternatively: anthropic + ANTHROPIC_API_KEY, openai + OPENAI_API_KEY,
# or openai-compatible + GATEWAY_OPENAI_BASE_URL and optionally OPENAI_API_KEY.
# Set GATEWAY_LLM_MODEL to a model supported by that provider.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GATEWAY_OPENAI_BASE_URL=

GATEWAY_PORT=8000
SPARK_CONNECT_PORT=15002
MINIO_CONSOLE_PORT=9001
