<!--
  Maven Build Cache Extension configuration. Inert unless -Dmaven.build.cache.enabled=true.

  A module whose inputs (sources, resources, pom, upstream module hashes, active profiles) match a
  cached build gets its target/ restored instead of recompiled. Two things are deliberately never
  cached, whatever the hash says:
  - test execution: surefire, failsafe, scalatest and the jacoco agent always run, so a cache hit
    only ever saves compilation, never a test result;
  - install: the local repository is not updated on a hit unless install runs, and CI's test steps
    resolve sibling modules from the local repository.
  The input glob is widened from the extension's default (java, xml, properties) to every file,
  because Hudi compiles Scala, Avro, protobuf and thrift sources and reads many test resources.
-->
<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.3.0"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.3.0 https://maven.apache.org/xsd/build-cache-config-1.3.0.xsd">
  <configuration>
    <enabled>false</enabled>
    <hashAlgorithm>XX</hashAlgorithm>
    <validateXml>true</validateXml>
    <!-- A hit restores the jars by default; the class directories must be listed so the test
         steps that follow (mvn test -pl module, cache off) find up-to-date classes and skip
         compilation the way they do after a real build. maven-status carries the compiler
         plugin's incremental-build bookkeeping. -->
    <attachedOutputs>
      <dirNames>
        <dirName>classes</dirName>
        <dirName>test-classes</dirName>
        <dirName>maven-status</dirName>
        <!-- scala-maven-plugin keeps its last-compile marker as target/classes.<hash>.timestamp -->
        <dirName glob="*.timestamp">.</dirName>
      </dirNames>
    </attachedOutputs>
  </configuration>
  <input>
    <global>
      <glob>{*}</glob>
      <includes>
        <include>src/</include>
      </includes>
      <excludes>
        <exclude>target/</exclude>
        <exclude>*.md</exclude>
      </excludes>
    </global>
  </input>
  <executionControl>
    <runAlways>
      <plugins>
        <plugin artifactId="maven-surefire-plugin"/>
        <plugin artifactId="maven-failsafe-plugin"/>
        <plugin artifactId="scalatest-maven-plugin"/>
        <plugin artifactId="jacoco-maven-plugin"/>
      </plugins>
      <goalsLists>
        <goalsList artifactId="maven-install-plugin">
          <goals>
            <goal>install</goal>
          </goals>
        </goalsList>
      </goalsLists>
    </runAlways>
  </executionControl>
</cache>
